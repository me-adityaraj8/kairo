DATABASE_URL=
DIRECT_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional OAuth. Each provider's buttons only appear when both of its
# variables are set, so the app runs fine without them.
# Google:  console.cloud.google.com  → callback /api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub:  github.com/settings/developers → callback /api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
